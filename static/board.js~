// Moonboard Masters 2017 (40°) interactive grid: columns A to K, rows 1 to 18.
(function () {
  const COLS = "ABCDEFGHIJK";
  const ROWS = 18;
  // Tap cycle: none -> middle -> start -> end -> none
  const ROLE_CYCLE = [null, "middle", "start", "end"];

  // Builds the grid. Row 18 is at the top, row 1 at the bottom.
  function buildGrid(container, { showLabels }) {
    container.classList.add("board");

    const wrap = document.createElement("div");
    wrap.className = "board-wrap";

    if (showLabels) {
      const rowLabels = document.createElement("div");
      rowLabels.className = "row-labels";
      for (let r = ROWS; r >= 1; r--) {
        const span = document.createElement("span");
        span.textContent = r;
        rowLabels.appendChild(span);
      }
      wrap.appendChild(rowLabels);
    }

    const main = document.createElement("div");
    main.className = "board-main";

    const grid = document.createElement("div");
    grid.className = "board-grid";
    for (let r = ROWS; r >= 1; r--) {
      for (let c = 0; c < COLS.length; c++) {
        const pos = COLS[c] + r;
        const cell = document.createElement("div");
        cell.className = "hold-cell";
        cell.dataset.pos = pos;
        cell.title = pos;
        grid.appendChild(cell);
      }
    }
    main.appendChild(grid);

    if (showLabels) {
      const colLabels = document.createElement("div");
      colLabels.className = "col-labels";
      for (const letter of COLS) {
        const span = document.createElement("span");
        span.textContent = letter;
        colLabels.appendChild(span);
      }
      main.appendChild(colLabels);
    }

    wrap.appendChild(main);
    container.appendChild(wrap);
    return grid;
  }

  // "C5 start, F9, H14 end" -> { C5: "start", F9: "middle", H14: "end" }
  function parseText(text) {
    const holds = {};
    text.split(",").forEach((part) => {
      const tokens = part.trim().split(/\s+/);
      if (!tokens[0]) return;
      const pos = tokens[0].toUpperCase();
      const word = (tokens[1] || "").toLowerCase();
      holds[pos] = word === "start" || word === "end" ? word : "middle";
    });
    return holds;
  }

  // Start hold first, end hold last
  function toText(holds) {
    const entries = Object.entries(holds);
    const ordered = [
      ...entries.filter(([, role]) => role === "start"),
      ...entries.filter(([, role]) => role === "middle"),
      ...entries.filter(([, role]) => role === "end"),
    ];
    return ordered
      .map(([pos, role]) => (role === "middle" ? pos : `${pos} ${role}`))
      .join(", ");
  }

  // Sets each cell's class to match its role
  function paint(grid, holds) {
    grid.querySelectorAll(".hold-cell").forEach((cell) => {
      const role = holds[cell.dataset.pos];
      cell.className = "hold-cell" + (role ? " " + role : "");
    });
  }

  // Editable board, kept in sync with a text input
  function initEditor(container, inputEl) {
    const grid = buildGrid(container, { showLabels: false });
    container.classList.add("board-editable");

    let holds = parseText(inputEl.value);
    paint(grid, holds);

    grid.addEventListener("click", (e) => {
      const cell = e.target.closest(".hold-cell");
      if (!cell) return;
      const pos = cell.dataset.pos;
      const current = holds[pos] || null;
      const next = ROLE_CYCLE[(ROLE_CYCLE.indexOf(current) + 1) % ROLE_CYCLE.length];

      // Only one start and one end: move the existing one to middle
      if (next === "start" || next === "end") {
        for (const key of Object.keys(holds)) {
          if (holds[key] === next) holds[key] = "middle";
        }
      }
      if (next) {
        holds[pos] = next;
      } else {
        delete holds[pos];
      }

      paint(grid, holds);
      inputEl.value = toText(holds);
    });

    inputEl.addEventListener("input", () => {
      holds = parseText(inputEl.value);
      paint(grid, holds);
    });
  }

  // Read-only preview on a saved problem card
  function initViewer(container) {
    const grid = buildGrid(container, { showLabels: false });
    container.classList.add("board-small");
    const holds = {};
    JSON.parse(container.dataset.holds).forEach((h) => {
      holds[h.position] = h.role;
    });
    paint(grid, holds);
  }

  const editor = document.getElementById("board-input");
  const holdsInput = document.getElementById("holds-input");
  if (editor && holdsInput) initEditor(editor, holdsInput);

  document.querySelectorAll(".board-view").forEach(initViewer);
})();
